# Shell scripts are scp'd straight from the working tree to Linux devices.
# A CRLF checkout on Windows makes them fail with "bad interpreter", so pin LF
# regardless of the local core.autocrlf setting.
*.sh text eol=lf

# The Pi launchers carry no extension: `run` is the Pi Appliance Kit entrypoint
# (install-app.sh rsyncs it straight from the working tree, and app.service will
# not start a script whose shebang ends in CR). Both appliances use the same
# extensionless `run`.
run          text eol=lf
