<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Libraries\Neomotive.Camera.USB\Neomotive.Camera.USB.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Neomotive.Camera.VideoFile\Neomotive.Camera.VideoFile.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Neomotive.SpeedLimit\Neomotive.SpeedLimit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <!-- Windows runtime included -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- Linux: Use system-installed OpenCV (install via: apt-get install libopencv-dev) -->
  </ItemGroup>

  <!-- Include native libraries in publish output -->
  <ItemGroup>
    <None Include="native/linux-arm64/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
