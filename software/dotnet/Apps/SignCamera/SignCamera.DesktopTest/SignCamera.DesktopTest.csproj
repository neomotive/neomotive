<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241117" />
    <!-- Windows runtime included -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241117" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- Linux: Use system-installed OpenCV (install via: apt-get install libopencv-dev) -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Libraries\Neomotive.Camera.USB\Neomotive.Camera.USB.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Neomotive.Camera.VideoFile\Neomotive.Camera.VideoFile.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Neomotive.SpeedLimit\Neomotive.SpeedLimit.csproj" />
  </ItemGroup>

</Project>
