<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Neomotive.ModuleSimulator.UI.Views;assembly=Neomotive.ModuleSimulator.UIShared"
        xmlns:toolbox="clr-namespace:Neomotive.ModuleSimulator.UI.Toolbox"
        x:Class="Neomotive.ModuleSimulator.UI.DesktopShellWindow"
        Title="Neomotive Module Simulator"
        Width="1080" Height="480"
        CanResize="True"
        Background="#111418">

    <Viewbox Stretch="Uniform">
        <Grid Width="1080" Height="480" ColumnDefinitions="800, *">
            <!-- 800×480 simulator panel -->
            <views:SimulatorView Grid.Column="0" x:Name="SimulatorPanel" />

            <!-- Hardware toolbox — DataContext set to ToolboxViewModel in code-behind -->
            <toolbox:ToolboxView Grid.Column="1" x:Name="ToolboxPanel" />
        </Grid>
    </Viewbox>

</Window>
