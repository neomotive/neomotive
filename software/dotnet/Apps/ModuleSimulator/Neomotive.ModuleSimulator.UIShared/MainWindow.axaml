<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
        xmlns:views="clr-namespace:Neomotive.ModuleSimulator.UI.Views"
        x:Class="Neomotive.ModuleSimulator.UI.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Neomotive Module Simulator"
        Width="800" Height="480"
        MinWidth="800" MinHeight="480"
        CanResize="False"
        SystemDecorations="None"
        Position="0,0"
        Background="#111418">

    <views:SimulatorView />

</Window>
