<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
             x:Class="Neomotive.ModuleSimulator.UI.Views.DataView"
             x:DataType="local:MainWindowViewModel">
    <ScrollViewer Padding="12,8">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding DataFields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DataFieldItem">
                        <Grid ColumnDefinitions="140, *" Margin="0,0,0,3">
                            <TextBlock Grid.Column="0" Classes="label" Text="{Binding Field}" />
                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bench fixture for ScanTool capture: replays a scripted crank over CAN so
                 triggers, pre-trigger retention and stall detection can be exercised without
                 a vehicle. Each profile is one branch of the hard-start diagnostic. -->
            <TextBlock Classes="label" Margin="0,16,0,4" Text="Start attempt" />
            <WrapPanel>
                <Button Content="Healthy"      Margin="0,0,6,6" Click="OnHealthyStart" />
                <Button Content="Weak Pump"    Margin="0,0,6,6" Click="OnWeakLiftPump" />
                <Button Content="Rail Collapse" Margin="0,0,6,6" Click="OnRailCollapse" />
                <Button Content="Weak Battery" Margin="0,0,6,6" Click="OnWeakBattery" />
                <Button Content="No Crank"     Margin="0,0,6,6" Click="OnNoCrank" />
                <Button Content="Stop"         Margin="0,0,6,6" Click="OnStopAttempt" />
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
