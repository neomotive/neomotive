<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
             x:Class="Neomotive.ModuleSimulator.UI.Views.ConfigView"
             x:DataType="local:MainWindowViewModel">
    <ScrollViewer Padding="12,8">
        <StackPanel>

            <!-- VIN -->
            <TextBlock Classes="heading" Text="VIN" Margin="0,0,0,6" />
            <TextBox Text="{Binding ConfigVin}"
                     FontFamily="Consolas,Cascadia Code,monospace"
                     FontSize="11" Foreground="#E0E5EC"
                     Background="#1A1E26" BorderBrush="#2E3440"
                     Width="180" MaxLength="17"
                     Watermark="1M8GDM9AXKP042788"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,4" />
            <TextBlock Classes="muted xs" Text="{Binding ConfigVinFeedback}"
                       IsVisible="{Binding HasConfigVinNote}"
                       FontStyle="Italic" Margin="0,0,0,12" />

            <!-- CAN log -->
            <TextBlock Classes="heading" Text="CAN LOG" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Classes="label" Text="Max messages" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding CanLogMaxDepth}"
                               Minimum="10" Maximum="10000" Increment="10"
                               FormatString="0"
                               Background="#1A1E26" BorderBrush="#2E3440"
                               Foreground="#E0E5EC"
                               Width="90"
                               VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted xs" Text="FIFO — oldest messages are dropped when full"
                       FontStyle="Italic" Margin="0,0,0,16" />

            <!-- Units of measure -->
            <TextBlock Classes="heading" Text="UNITS OF MEASURE" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,16">
                <Button Classes="dtc" Classes.active="{Binding IsImperial}"
                        Content="Imperial" Click="OnSetImperial" />
                <Button Classes="dtc" Classes.active="{Binding IsMetric}"
                        Content="Metric" Click="OnSetMetric" />
            </StackPanel>

            <!-- Quick DTCs list -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <TextBlock Classes="heading" Text="QUICK DTCs" VerticalAlignment="Center" />
                <TextBlock Classes="muted xs"
                           Text="{Binding ConfigDtcs.Count, StringFormat='{}{0}/10'}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="muted" Text="No quick DTCs configured. Add one below."
                       IsVisible="{Binding HasNoQuickDtcs}"
                       FontStyle="Italic" Margin="0,0,0,6" />

            <ItemsControl ItemsSource="{Binding ConfigDtcs}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:QuickDtcConfig">
                        <Grid ColumnDefinitions="72, *, 28" Margin="0,0,0,3">
                            <TextBlock Grid.Column="0" Classes="error" Text="{Binding Code}" />
                            <TextBlock Grid.Column="1" Classes="label" Text="{Binding Description}" />
                            <Button    Grid.Column="2" Classes="action-sm" Content="✕"
                                       Tag="{Binding Code}" Click="OnRemoveQuickDtc"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add new quick DTC -->
            <Rectangle Height="1" Fill="#2E3440" Margin="0,0,0,10" />
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="Code" VerticalAlignment="Center" Width="36" />
                    <TextBox Text="{Binding NewDtcCode}"
                             FontFamily="Consolas,Cascadia Code,monospace"
                             FontSize="11" Foreground="#E0E5EC"
                             Background="#1A1E26" BorderBrush="#2E3440"
                             Width="70" MaxLength="5"
                             Watermark="P0300"
                             VerticalAlignment="Center" />
                    <TextBlock Classes="label" Text="Description" VerticalAlignment="Center" />
                    <TextBox Text="{Binding NewDtcDescription}"
                             FontFamily="Consolas,Cascadia Code,monospace"
                             FontSize="11" Foreground="#E0E5EC"
                             Background="#1A1E26" BorderBrush="#2E3440"
                             MinWidth="180"
                             Watermark="(optional)"
                             VerticalAlignment="Center" />
                    <Button Classes="action-sm" Content="Add"
                            IsEnabled="{Binding CanAddDtc}"
                            Click="OnAddQuickDtc" />
                </StackPanel>
                <TextBlock Classes="label" Text="{Binding ConfigFeedback}" />
            </StackPanel>

            <!-- Updates -->
            <Rectangle Height="1" Fill="#2E3440" Margin="0,8,0,10" />
            <TextBlock Classes="heading" Text="SOFTWARE UPDATES" Margin="0,0,0,6" />
            <Border Background="#1A1E24" BorderBrush="#2E3440" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                           Foreground="#C8CED8" />
            </Border>
            <Button Content="Check for Updates"
                    Classes="action-sm"
                    IsEnabled="{Binding CanCheckUpdate}"
                    Click="OnCheckForUpdates"
                    Margin="0,0,0,6" />
            <TextBlock Classes="muted xs" FontStyle="Italic" TextWrapping="Wrap"
                       Text="USB: Insert a drive with neomotive-update*.zip — detected automatically." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
