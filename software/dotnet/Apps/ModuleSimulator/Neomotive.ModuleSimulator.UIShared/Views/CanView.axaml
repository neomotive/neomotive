<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
             x:Class="Neomotive.ModuleSimulator.UI.Views.CanView"
             x:DataType="local:MainWindowViewModel">
    <Grid RowDefinitions="Auto, *">
        <!-- ── Bus Status Header ────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#1A1F28"
                BorderBrush="#2E3440"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,0,0,5">
                    <TextBlock Grid.Column="0" Classes="heading" Text="CAN BUS" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasAutoReconnects}">
                        <TextBlock Classes="warn xs" Text="● Auto-reconnects: " />
                        <TextBlock Classes="warn xs" Text="{Binding AutoReconnectCount}" FontWeight="Bold" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="Auto-reconnect" IsChecked="{Binding AutoReconnect}" 
                              FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Grid.Column="3" Classes="action-sm" Content="Reset Errors"
                            IsVisible="{Binding HasCanHealthData}"
                            Click="OnResetCanErrors" />
                </Grid>

                <Grid ColumnDefinitions="*, *, *, *">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="Status" />
                        <TextBlock Classes="ok xs" Text="● No errors" IsVisible="{Binding HasNoCanErrors}" />
                        <TextBlock Classes="error xs" Text="● Bus Stuck (INT Locked)" IsVisible="{Binding CanBusStuck}" />
                        <TextBlock Classes="warn xs" Text="● Errors active" IsVisible="{Binding HasCanHealthData}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" IsVisible="{Binding HasCanHealthData}">
                        <TextBlock Classes="label" Text="Error Events" />
                        <TextBlock Classes="error" Text="{Binding CanBusErrorCount}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0" IsVisible="{Binding HasCanHealthData}">
                        <TextBlock Classes="label" Text="Last TEC" />
                        <TextBlock Classes="warn"
                                   Text="{Binding CanLastTxErrors}"
                                   IsVisible="{Binding !CanTxErrorSevere}" />
                        <TextBlock Classes="error"
                                   Text="{Binding CanLastTxErrors}"
                                   IsVisible="{Binding CanTxErrorSevere}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10,0,0,0" IsVisible="{Binding HasCanHealthData}">
                        <TextBlock Classes="label" Text="Last REC" />
                        <TextBlock Classes="warn" Text="{Binding CanLastRxErrors}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Packet Log ───────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#0E1115"
                Padding="12,6">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Classes="heading" Text="CAN PACKETS" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="action-sm" Content="Clear Log"
                            IsVisible="{Binding HasCanPackets}"
                            Click="OnClearCanLog" />
                </Grid>

                <TextBlock Grid.Row="1" Classes="dim"
                           Text="Waiting for CAN frames..."
                           IsVisible="{Binding HasNoCanPackets}"
                           VerticalAlignment="Center" />

                <ScrollViewer Grid.Row="1" x:Name="CanLogScroller"
                              IsVisible="{Binding HasCanPackets}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CanLogItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CanLogItem">
                                <Grid ColumnDefinitions="100, 38, 28, 185, *" Margin="0,1">
                                    <TextBlock Grid.Column="0" Classes="muted sm" Text="{Binding Time}" />
                                    <TextBlock Grid.Column="1" Classes="sm"       Text="{Binding Id}" />
                                    <TextBlock Grid.Column="2" Classes="tx sm"    Text="TX" IsVisible="{Binding IsOutgoing}" />
                                    <TextBlock Grid.Column="2" Classes="rx sm"    Text="RX" IsVisible="{Binding !IsOutgoing}" />
                                    <TextBlock Grid.Column="3" Classes="muted sm" Text="{Binding Data}" />
                                    <TextBlock Grid.Column="4" Classes="sm"       Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
