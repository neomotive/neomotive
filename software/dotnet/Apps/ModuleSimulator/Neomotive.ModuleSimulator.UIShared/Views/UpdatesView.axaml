<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
             x:Class="Neomotive.ModuleSimulator.UI.Views.UpdatesView"
             x:DataType="local:MainWindowViewModel"
             Padding="20,16">

    <StackPanel Spacing="16">

        <TextBlock Classes="heading" Text="SOFTWARE UPDATES" />

        <!-- Status area -->
        <Border Background="#1A1E24" BorderBrush="#2E3440" BorderThickness="1" Padding="14,10">
            <TextBlock Text="{Binding UpdateStatus}"
                       TextWrapping="Wrap"
                       Foreground="#C8CED8" />
        </Border>

        <!-- Network check button -->
        <Button Content="Check for Updates"
                Classes="action-sm"
                IsEnabled="{Binding CanCheckUpdate}"
                Click="OnCheckForUpdates" />

        <!-- USB hint -->
        <TextBlock Classes="muted xs"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Text="USB: Insert a drive containing neomotive-update*.zip — updates are detected and applied automatically." />

    </StackPanel>

</UserControl>
