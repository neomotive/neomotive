<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ModuleSimulator.UI"
             x:Class="Neomotive.ModuleSimulator.UI.Views.UpdatesView"
             x:DataType="local:MainWindowViewModel"
             xmlns:controls="clr-namespace:Neomotive.UI.Controls;assembly=Neomotive.UI.Styles">

    <Grid RowDefinitions="*, Auto">

      <ScrollViewer Grid.Row="0">
        <StackPanel Spacing="16" Margin="20,16">

        <TextBlock Classes="heading" Text="SOFTWARE UPDATES" />

        <!-- Installed version. First thing the operator needs when deciding
             whether a check is even worth making. -->
        <Border Background="#1A1E24" BorderBrush="#2E3440" BorderThickness="1" Padding="14,10">
            <StackPanel Spacing="4">
                <TextBlock Text="INSTALLED VERSION" FontSize="10" LetterSpacing="2" Foreground="#7A8494" />
                <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}"
                           FontSize="22" FontWeight="SemiBold" Foreground="#E6EAF2" />
            </StackPanel>
        </Border>

        <!-- Status area -->
        <Border Background="#1A1E24" BorderBrush="#2E3440" BorderThickness="1" Padding="14,10">
            <TextBlock Text="{Binding UpdateStatus}"
                       TextWrapping="Wrap"
                       Foreground="#C8CED8" />
        </Border>

        <!-- Network check button. Goes straight to the GitHub release manifest
             unless neomotive.config.json overrides the URL. -->
        <Button Content="Check Internet for Updates"
                Classes="action-sm"
                IsEnabled="{Binding CanCheckUpdate}"
                Click="OnCheckForUpdates" />

        <TextBlock Text="{Binding UpdateSourceUrl}"
                   FontSize="10" Foreground="#5C6675"
                   TextWrapping="Wrap" />

        <!-- Divider -->
        <Rectangle Height="1" Fill="#2E3440" Margin="0,4,0,0" />
        <TextBlock Classes="heading" Text="USB UPDATE" FontSize="10" LetterSpacing="2" Margin="0,4,0,0" />

        <!-- USB status -->
        <Border Background="#1A1E24" BorderBrush="#2E3440" BorderThickness="1" Padding="14,10">
            <TextBlock Text="{Binding UsbStatusText}"
                       TextWrapping="Wrap"
                       Foreground="#C8CED8" />
        </Border>

        <!-- Update from USB button — only visible when a single matching update is detected -->
        <Button Content="Update from USB"
                Classes="action-sm"
                IsVisible="{Binding UsbUpdateReady}"
                IsEnabled="{Binding CanApplyUsbUpdate}"
                Click="OnApplyUsbUpdate" />

        </StackPanel>
      </ScrollViewer>

      <!-- Network status: connection state, hostname, and IP when assigned -->
      <controls:NetworkStatusBar Grid.Row="1" />

    </Grid>

</UserControl>
