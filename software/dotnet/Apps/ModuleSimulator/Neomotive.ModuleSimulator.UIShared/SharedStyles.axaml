<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StyleInclude Source="avares://Neomotive.UI.Styles/Styles.axaml" />

    <!-- ── Module panel ────────────────────────────────────────────────── -->

    <Style Selector="Border.module">
        <Setter Property="Background"      Value="{StaticResource BrushBgModule}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="3" />
        <Setter Property="Padding"         Value="8,6" />
        <Setter Property="Margin"          Value="0,0,0,5" />
        <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Border.module.selected">
        <Setter Property="Background"  Value="{StaticResource BrushBgModuleSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSelected}" />
    </Style>

    <!-- ── DTC toggle buttons ──────────────────────────────────────────── -->

    <Style Selector="Button.dtc">
        <Setter Property="Background"      Value="{StaticResource BrushBgDtc}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="3" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="Margin"          Value="0,0,6,0" />
        <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
        <Setter Property="FontSize"        Value="14" />
        <Setter Property="Foreground"      Value="{StaticResource BrushFgSubtle}" />
    </Style>
    <Style Selector="Button.dtc:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgDtcHover}" />
    </Style>
    <Style Selector="Button.dtc.active">
        <Setter Property="Background"  Value="{StaticResource BrushBgDtcActive}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDtcActive}" />
        <Setter Property="Foreground"  Value="{StaticResource BrushError}" />
    </Style>
    <Style Selector="Button.dtc.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgDtcActiveHover}" />
    </Style>

    <!-- ── Monitor row toggle ──────────────────────────────────────────── -->

    <Style Selector="Button.monitor-row">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="HorizontalAlignment"      Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin"                   Value="0,0,0,2" />
        <Setter Property="Cursor"                   Value="Hand" />
    </Style>
    <Style Selector="Button.monitor-row TextBlock">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.monitor-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushBgMonitorHover}" />
    </Style>
    <Style Selector="Button.monitor-row:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor"     Value="Arrow" />
    </Style>

    <!-- ── Category cycle button ────────────────────────────────────────── -->

    <Style Selector="Button.category">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="Foreground"      Value="{StaticResource BrushFgSubtle}" />
        <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
        <Setter Property="FontSize"        Value="11" />
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.category:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushFgValue}" />
    </Style>

</Styles>
