[Unit]
Description=Neomotive boot splash
DefaultDependencies=no
After=local-fs.target
ConditionPathExists=/opt/neomotive/splash.png

[Service]
Type=simple
ExecStart=/usr/bin/fbi -T 1 --noverbose --fitwidth /opt/neomotive/splash.png
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes

[Install]
WantedBy=sysinit.target
