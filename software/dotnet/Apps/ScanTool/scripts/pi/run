#!/bin/sh
# Pi Appliance Kit entrypoint. app-launch cd's here and exec's this file.
#
# The rootfs is a read-only overlay; /data is the only writable mount, and
# app.service sets ProtectHome=yes, so every path .NET wants to write must be
# redirected under the app directory.
set -e

# Normally this file IS $APP_DIR/run, so its own directory is the app root. When
# it is the packaged copy (see the handoff below) it lives two levels down at
# app-current/launcher/run, and the outer launcher passes the real root through
# NEOMOTIVE_APP_DIR — deriving it from $0 there would point at launcher/.
if [ -n "${NEOMOTIVE_APP_DIR:-}" ]; then
    APP_DIR="$NEOMOTIVE_APP_DIR"
else
    APP_DIR="$(cd "$(dirname "$0")" && pwd)"
fi
export NEOMOTIVE_APP_DIR="$APP_DIR"

# ── Hand off to the packaged launcher ────────────────────────────────────────
# This file sits at $APP_DIR/run, OUTSIDE the A/B slots, so an update package —
# which only ever replaces app-current/ — can never change it. Without a handoff
# every launcher fix would need SSH or a USB stick on every device forever.
#
# So: if the promoted slot ships its own launcher, run that instead. The guards
# matter more than the feature — a bad launcher on a read-only appliance is a
# brick with no console. Delegate only to a readable file that the shell can
# actually parse, and fall through to the logic below on any doubt.
# NEOMOTIVE_LAUNCHER_DELEGATED stops a packaged launcher that re-execs from
# looping forever.
PACKAGED="$APP_DIR/app-current/launcher/run"
if [ -z "${NEOMOTIVE_LAUNCHER_DELEGATED:-}" ] && [ -r "$PACKAGED" ]; then
    if sh -n "$PACKAGED" 2>/dev/null; then
        NEOMOTIVE_LAUNCHER_DELEGATED=1
        export NEOMOTIVE_LAUNCHER_DELEGATED
        exec sh "$PACKAGED" "$@"
    fi
    echo "run: $PACKAGED failed a syntax check — using the built-in launcher" >&2
fi

export HOME="$APP_DIR"
export DOTNET_BUNDLE_EXTRACT_BASE_DIR="$APP_DIR/.dotnet-extract"
export XDG_RUNTIME_DIR="$APP_DIR/.runtime"
export DOTNET_EnableWriteXorExecute=0
export DOTNET_gcServer=0

# app.service sets ProtectSystem=strict with ReadWritePaths=/data, which mounts
# EVERYTHING outside /data read-only in this unit's namespace — /tmp included.
# .NET's Path.GetTempPath() honours TMPDIR, so point it at the writable partition;
# without this anything that touches temp (zip extraction, X11, the updater's
# download) dies with "Access to the path '/tmp/...' is denied".
export TMPDIR="$APP_DIR/.tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"

mkdir -p "$DOTNET_BUNDLE_EXTRACT_BASE_DIR" "$XDG_RUNTIME_DIR" "$TMPDIR"
chmod 700 "$XDG_RUNTIME_DIR"

# The updater's A/B directories. Created here as well as in-app so a device that
# has only ever been rsynced by install-app.sh still has somewhere to stage.
mkdir -p "$APP_DIR/data" "$APP_DIR/config" "$APP_DIR/app-downloads"

# ── Device-local overrides ───────────────────────────────────────────────────
# Do NOT uncomment settings in this file to change a device: `run` is part of the
# payload and every deploy overwrites it, so edits here are silently reverted.
#
# Put them in $APP_DIR/local.env instead. That file is not in the payload, and
# the deploy extracts over the top without deleting, so it survives upgrades:
#
#   ssh pi@pi-appliance.local 'cat >> /data/app/local.env' <<'EOF'
#   export SCANTOOL_CAN_CHANNEL=1
#   EOF
#   ssh -t pi@pi-appliance.local 'sudo systemctl restart app.service'
#
# Recognized variables:
#   SCANTOOL_CAN_CHANNEL   CAN HAT channel: 0 (default) or 1
#   SCANTOOL_DRM_CARD      e.g. /dev/dri/card1 if the panel is not on the default
#   SCANTOOL_DRM_SCALING   e.g. 1.0
#   SCANTOOL_UDP_LOG       1 to also ship Meadow logs off-box over UDP
#
# `if` rather than `[ -f ] && .` because set -e would treat the false test as a
# fatal error when the file is absent — i.e. on every normal device.
if [ -f "$APP_DIR/local.env" ]; then
    . "$APP_DIR/local.env"
fi

# ── A/B slot resolution ──────────────────────────────────────────────────────
# The binary runs from $APP_DIR/app-current so an in-app update can swap slots
# atomically (current→previous, staging→current) without touching the running
# file. Pre-A/B payloads put the binary directly in $APP_DIR; keep starting
# those so a device that has not been migrated still boots.
if [ -f "$APP_DIR/app-current/scantool" ]; then
    BIN="$APP_DIR/app-current/scantool"
elif [ -f "$APP_DIR/scantool" ]; then
    BIN="$APP_DIR/scantool"
else
    echo "run: no scantool binary in $APP_DIR/app-current or $APP_DIR" >&2
    exit 1
fi

# Defensive: install-app.sh only chmods `run`, so if the payload was rsynced
# from a filesystem without POSIX modes the binary can arrive non-executable.
[ -x "$BIN" ] || chmod +x "$BIN"

# ── Supervise, don't exec ────────────────────────────────────────────────────
# After an update the app swaps slots and exits 42 to ask for a relaunch. exec
# would replace this shell and there would be nothing left to start the new
# binary, so loop instead and re-resolve $BIN each pass — the file that was
# app-current a moment ago is app-previous now. Any other exit code is the
# app's own, and is passed through to app.service unchanged.
while :; do
    # `&& rc=0 || rc=$?` rather than a bare call: set -e is suspended on the
    # left of ||, so a non-zero exit reaches the check instead of killing us.
    "$BIN" "$@" && rc=0 || rc=$?
    [ "$rc" -eq 42 ] || exit "$rc"

    if [ -f "$APP_DIR/app-current/scantool" ]; then
        BIN="$APP_DIR/app-current/scantool"
    fi
    [ -x "$BIN" ] || chmod +x "$BIN"
    echo "run: restarting after update -> $BIN" >&2
done
