<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:core="clr-namespace:Neomotive.ScanTool.Core;assembly=Neomotive.ScanTool.Core"
             x:Class="Neomotive.ScanTool.UI.Views.DtcsView"
             x:DataType="local:MainWindowViewModel"
             Padding="20,16">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- MIL status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
            <TextBlock Classes="label" Text="MIL:" VerticalAlignment="Center" />
            <TextBlock Classes="mil-on"  IsVisible="{Binding MilOn}"  Text="ON  (Check Engine)" />
            <TextBlock Classes="mil-off" IsVisible="{Binding MilOff}" Text="OFF" />
        </StackPanel>

        <!-- Per-module DTC groups -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ModuleDtcGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:ModuleDtcGroup">
                        <StackPanel Margin="0,0,0,18">

                            <!-- Module header -->
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding Module.Name}" />
                                    <TextBlock Classes="dim xs" VerticalAlignment="Center" Text="{Binding Module.AddressHex}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Classes="action-sm"
                                        Click="OnClearModuleDtcs" />
                            </Grid>

                            <!-- Separator -->
                            <Rectangle Height="1" Fill="#2E3440" Margin="0,0,0,8" />

                            <!-- No faults -->
                            <TextBlock Classes="dim"
                                       IsVisible="{Binding !HasAny}"
                                       Text="No DTCs" />

                            <!-- Stored DTCs -->
                            <TextBlock Classes="heading"
                                       IsVisible="{Binding HasStoredDtcs}"
                                       Text="STORED"
                                       Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding StoredDtcs}"
                                          IsVisible="{Binding HasStoredDtcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:DiagnosticTroubleCode">
                                        <Grid ColumnDefinitions="80, *" Margin="0,2">
                                            <TextBlock Grid.Column="0" Classes="error" Text="{Binding Code}" />
                                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Description}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pending DTCs -->
                            <TextBlock Classes="heading"
                                       IsVisible="{Binding HasPendingDtcs}"
                                       Text="PENDING"
                                       Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding PendingDtcs}"
                                          IsVisible="{Binding HasPendingDtcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:DiagnosticTroubleCode">
                                        <Grid ColumnDefinitions="80, *" Margin="0,2">
                                            <TextBlock Grid.Column="0" Classes="warn" Text="{Binding Code}" />
                                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Description}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Refresh"
                    Classes="action-sm"
                    IsEnabled="{Binding CanRefresh}"
                    Click="OnRefresh" />
            <Button Content="Clear All DTCs"
                    Classes="action-sm"
                    IsEnabled="{Binding IsConnected}"
                    Click="OnClearDtcs" />
        </StackPanel>

    </Grid>

</UserControl>
