<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             x:Class="Neomotive.ScanTool.UI.Views.ConnectionView"
             x:DataType="local:MainWindowViewModel"
             Padding="20,16">

    <StackPanel Spacing="16" MaxWidth="400">

        <TextBlock Classes="heading" Text="ADAPTER" />

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Status" />
            <TextBlock Text="{Binding StatusText}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Bitrate" />
            <TextBlock Classes="value" Text="500 kbps (ISO 15765-4)" />
        </StackPanel>

        <!-- The reason this screen exists, sized accordingly: action-primary rather than the
             action-sm the secondary buttons use. Only ever one of the two is visible, so the pair
             reads as a single large button that changes what it says. -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
            <Button Content="Connect"
                    Classes="action-primary"
                    IsEnabled="{Binding CanConnect}"
                    IsVisible="{Binding IsNotConnected}"
                    Click="OnConnect" />
            <Button Content="Disconnect"
                    Classes="action-primary danger"
                    IsVisible="{Binding IsConnected}"
                    Click="OnDisconnect" />
        </StackPanel>

        <TextBlock Classes="muted xs"
                   IsVisible="{Binding IsConnected}"
                   Text="Connected — switch to Vehicle or DTCs tab to view data." />

        <TextBlock Classes="dim"
                   IsVisible="{Binding IsNotConnected}"
                   Text="{Binding AdapterHint}" />

        <!-- The same help the failure dialog shows, reachable without having to fail again.
             Spelled out rather than a bare "Help": on a touch panel the label is the only thing
             that says what the button will do. -->
        <Button Content="Which pins should I check?"
                Classes="action-sm"
                HorizontalAlignment="Left"
                IsVisible="{Binding IsNotConnected}"
                Click="OnShowPinHelp" />

    </StackPanel>

</UserControl>
