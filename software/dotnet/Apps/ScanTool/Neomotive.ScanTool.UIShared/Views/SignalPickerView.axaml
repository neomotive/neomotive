<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             x:Class="Neomotive.ScanTool.UI.Views.SignalPickerView"
             x:DataType="local:SignalPickerViewModel">

    <!-- Modal content. Hosted as an overlay rather than a Window: the Pi runs a single-view
         DRM lifetime with no window manager, so a real dialog would have nowhere to go. -->
    <Border Background="#141820" BorderBrush="#2E3440" BorderThickness="1" CornerRadius="6"
            Margin="24" Padding="0">
        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <!-- Search -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,10,10,6" ColumnSpacing="8">
                <TextBox Grid.Column="0" Name="SearchBox"
                         Watermark="Search name, PID number, unit or tag…"
                         Text="{Binding SearchText}" />
                <TextBlock Grid.Column="1" Classes="xs dim" VerticalAlignment="Center"
                           Text="{Binding SelectedCountText}" />
            </Grid>

            <!-- System filter chips: multi-select, because a signal can belong to several.
                 No ScrollViewer here on purpose — an unbounded width stops the WrapPanel
                 wrapping, which is what forced horizontal scrolling. -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding SystemFilters}" Margin="10,0,10,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SystemFilterItem">
                        <Button Classes="chip" Margin="0,0,4,4" Padding="7,3"
                                Click="OnToggleSystem" Tag="{Binding}">
                            <TextBlock FontSize="11" Text="{Binding Label}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Results -->
            <Border Grid.Row="2" Background="#0E1117" BorderBrush="#1E2530" BorderThickness="0,1,0,1">
                <!-- Virtualized on purpose. A bare ItemsControl realizes every row up front:
                     the standard table is ~110 signals, each row a Button plus a five-cell Grid,
                     so opening the picker built and laid out a thousand-odd controls in one pass.
                     That is imperceptible on the desktop and several seconds on the Pi. The
                     template below moves the ScrollViewer inside the control — an outer one hands
                     the panel infinite height, which silently defeats virtualization. -->
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SignalItem">
                            <!-- The systems list is a column, not a tooltip. It is the only
                                 thing the tip carried that the row did not already show, and
                                 on a touch panel a per-row tooltip is both unreachable and,
                                 when touch does fire it, drawn over the neighbouring rows.
                                 Capped width so it can never crowd out the name. -->
                            <Button Classes="pidrow" HorizontalAlignment="Stretch"
                                    Click="OnToggleSignal" Tag="{Binding}"
                                    ToolTip.Tip="{Binding DetailText}">
                                <Grid ColumnDefinitions="18, 52, *, Auto, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding SelectionIndicator}" />
                                    <!-- PID leads: techs usually arrive knowing the number. -->
                                    <TextBlock Grid.Column="1" Classes="xs"
                                               FontFamily="Consolas,Menlo,monospace"
                                               Foreground="{StaticResource BrushFgSubtle}"
                                               Text="{Binding ShortAddressText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <!-- Support state in words. Colour alone would not survive the
                                         panel's viewing angle, and there is no hover to explain a
                                         greyed row, so the row says what it means. -->
                                    <TextBlock Grid.Column="3" Classes="xs dim" VerticalAlignment="Center"
                                               IsVisible="{Binding HasSupportText}"
                                               Text="{Binding SupportText}" />
                                    <TextBlock Grid.Column="4" Classes="xs dim" MaxWidth="120"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Text="{Binding SystemsText}" />
                                    <TextBlock Grid.Column="5" Classes="xs dim" Text="{Binding Unit}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto"
                  Margin="10,8" ColumnSpacing="6">
                <Button Grid.Column="0" Content="Selected only" Click="OnToggleSelectedOnly" />
                <!-- Only offered once a vehicle has actually reported a support bitmap; before
                     that there is nothing to filter by and the button would be a lie. -->
                <Button Grid.Column="1" Click="OnToggleSupportedOnly"
                        IsVisible="{Binding HasSupportInfo}"
                        Content="{Binding SupportedOnlyLabel}" />
                <Button Grid.Column="2" Content="Add listed"    Click="OnSelectAllResults" />
                <Button Grid.Column="3" Content="Clear"         Click="OnClearSelection" />
                <TextBlock Grid.Column="4" Classes="xs dim" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,8,0"
                           Text="{Binding ResultCountText}" />
                <Button Grid.Column="5" Content="Cancel" Click="OnCancel" />
                <Button Grid.Column="6" Content="Done"   Click="OnConfirm" />
            </Grid>

        </Grid>
    </Border>
</UserControl>
