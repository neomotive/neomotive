<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:core="clr-namespace:Neomotive.ScanTool.Core;assembly=Neomotive.ScanTool.Core"
             x:Class="Neomotive.ScanTool.UI.Views.VehicleView"
             x:DataType="local:MainWindowViewModel"
             Padding="20,16">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="VIN" />
                <TextBlock Classes="vin" Text="{Binding DisplayVin}" />
            </StackPanel>

            <!-- VIN decoded info -->
            <StackPanel Spacing="10" IsVisible="{Binding HasVinDecode}">
                <Grid ColumnDefinitions="*,*,70">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="MAKE" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinMake}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="label" Text="MODEL" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinModel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="label" Text="YEAR" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinYear}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="COUNTRY OF MANUFACTURE" />
                    <TextBlock Classes="value" Text="{Binding DisplayVinCountry}" />
                </StackPanel>
            </StackPanel>

            <!-- Simulator indicator -->
            <Border Background="#0D1F0D" BorderBrush="#335033" BorderThickness="1" CornerRadius="4"
                    Padding="8,5" HorizontalAlignment="Left" IsVisible="{Binding IsSimulated}">
                <TextBlock Classes="ok" FontSize="11" Text="SIMULATOR" />
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Protocol" />
                <TextBlock Classes="value" Text="{Binding Protocol}" />
            </StackPanel>

            <TextBlock Classes="dim"
                       IsVisible="{Binding IsNotConnected}"
                       Text="Connect to a vehicle to read vehicle information." />

            <!-- Module tiles -->
            <TextBlock Classes="heading" Text="MODULES" IsVisible="{Binding IsConnected}" />

            <ItemsControl ItemsSource="{Binding Modules}" IsVisible="{Binding IsConnected}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:VehicleModule">
                        <Border Classes="module-tile"
                                Classes.fault="{Binding HasFaults}"
                                Margin="0,0,8,8">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="value" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                                <TextBlock Classes="dim xs"
                                           Text="{Binding AddressHex}" />
                                <Separator Height="1" Background="#2E3440" Margin="0,2" />
                                <TextBlock Classes="error"
                                           IsVisible="{Binding HasFaults}"
                                           Text="{Binding StoredDtcCount, StringFormat='{}{0} stored'}" />
                                <TextBlock Classes="warn xs"
                                           IsVisible="{Binding HasPendingDtcs}"
                                           Text="{Binding PendingDtcCount, StringFormat='{}{0} pending'}" />
                                <TextBlock Classes="ok"
                                           IsVisible="{Binding !HasFaults}"
                                           Text="Clean" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
