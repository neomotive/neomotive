<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:core="clr-namespace:Neomotive.ScanTool.Core;assembly=Neomotive.ScanTool.Core"
             x:Class="Neomotive.ScanTool.UI.Views.VehicleView"
             x:DataType="local:MainWindowViewModel"
             Padding="20,16">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Recognition band. Says whether this vehicle has been here before and whether its
                 calibration has moved since — the one line that turns a stored record into a
                 diagnostic result rather than just a faster startup. -->
            <Border IsVisible="{Binding HasRecognition}"
                    Background="#141820" BorderBrush="#2E3440" BorderThickness="1"
                    CornerRadius="4" Padding="10,8">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Classes="value" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="{Binding RecognitionText}" />
                    <Button Grid.Column="1" Content="Forget this vehicle" Classes="action-sm"
                            Margin="8,0,0,0" Click="OnForgetVehicle" />
                </Grid>
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="VIN" />
                <TextBlock Classes="vin" Text="{Binding DisplayVin}" />
            </StackPanel>

            <!-- VIN decoded info -->
            <StackPanel Spacing="10" IsVisible="{Binding HasVinDecode}">
                <Grid ColumnDefinitions="*,*,70">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="MAKE" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinMake}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="label" Text="MODEL" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinModel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="label" Text="YEAR" />
                        <TextBlock Classes="value" Text="{Binding DisplayVinYear}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="COUNTRY OF MANUFACTURE" />
                    <TextBlock Classes="value" Text="{Binding DisplayVinCountry}" />
                </StackPanel>
            </StackPanel>

            <!-- Calibration fingerprint / tune check -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="CALIBRATION" VerticalAlignment="Center" />
                    <!-- These fields now fill themselves on connect, so this button is what its
                         name says: the analysis step, not the only way to get a reading. -->
                    <Button Grid.Column="1" Content="Analyse tune"
                            Click="OnCheckTune" IsEnabled="{Binding CanCheckTune}" />
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="CAL ID" />
                        <TextBlock Classes="value" Text="{Binding DisplayCalibrationId}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="label" Text="CVN" />
                        <TextBlock Classes="value" Text="{Binding DisplayCvn}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="ECU NAME" />
                        <TextBlock Classes="value" Text="{Binding DisplayEcuName}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="label" Text="SUPPORTED PIDS" />
                        <TextBlock Classes="value" Text="{Binding SupportedPidSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Classes="xs dim" Text="{Binding TuneStatus}" TextWrapping="Wrap" />

                <Border IsVisible="{Binding HasTuneAssessment}"
                        Background="#141820" BorderBrush="#2E3440" BorderThickness="1"
                        CornerRadius="4" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="value" Text="{Binding TuneSummary}" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding TuneFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:TuneFinding">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Classes="value" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Classes="xs dim" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Simulator indicator -->
            <Border Background="#0D1F0D" BorderBrush="#335033" BorderThickness="1" CornerRadius="4"
                    Padding="8,5" HorizontalAlignment="Left" IsVisible="{Binding IsSimulated}">
                <TextBlock Classes="ok" FontSize="11" Text="SIMULATOR" />
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Protocol" />
                <TextBlock Classes="value" Text="{Binding Protocol}" />
            </StackPanel>

            <TextBlock Classes="dim"
                       IsVisible="{Binding IsNotConnected}"
                       Text="Connect to a vehicle to read vehicle information." />

            <!-- Module tiles -->
            <TextBlock Classes="heading" Text="MODULES" IsVisible="{Binding IsConnected}" />

            <!-- Only modules that answer legislated OBD-II show up here, which on most vehicles
                 built this century is the powertrain and nothing else. Saying so beats letting the
                 list imply the car has one controller. -->
            <TextBlock Classes="xs dim" TextWrapping="Wrap"
                       IsVisible="{Binding ShowFewModulesNote}"
                       Text="{Binding ModuleScopeNote}" />

            <ItemsControl ItemsSource="{Binding Modules}" IsVisible="{Binding IsConnected}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:VehicleModule">
                        <Border Classes="module-tile"
                                Classes.fault="{Binding HasFaults}"
                                Margin="0,0,8,8">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="value" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                                <TextBlock Classes="dim xs"
                                           Text="{Binding AddressHex}" />
                                <Separator Height="1" Background="#2E3440" Margin="0,2" />
                                <TextBlock Classes="error"
                                           IsVisible="{Binding HasFaults}"
                                           Text="{Binding StoredDtcCount, StringFormat='{}{0} stored'}" />
                                <TextBlock Classes="warn xs"
                                           IsVisible="{Binding HasPendingDtcs}"
                                           Text="{Binding PendingDtcCount, StringFormat='{}{0} pending'}" />
                                <TextBlock Classes="ok"
                                           IsVisible="{Binding !HasFaults}"
                                           Text="Clean" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
