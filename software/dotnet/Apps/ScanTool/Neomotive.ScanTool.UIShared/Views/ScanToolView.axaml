<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:views="clr-namespace:Neomotive.ScanTool.UI.Views"
             x:Class="Neomotive.ScanTool.UI.Views.ScanToolView"
             x:DataType="local:MainWindowViewModel">

    <Grid RowDefinitions="42, *">

        <!-- Tab bar -->
        <Border Grid.Row="0"
                Background="#141820"
                BorderBrush="#2E3440"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Connection" Classes="tab" Classes.active="{Binding IsConnectionView}" Click="OnShowConnection" />
                    <Button Content="Vehicle"    Classes="tab" Classes.active="{Binding IsVehicleView}"    Click="OnShowVehicle" />
                    <Button Content="Emissions"  Classes="tab" Classes.active="{Binding IsEmissionsView}"  Click="OnShowEmissions" />
                    <Button Content="DTCs"       Classes="tab" Classes.active="{Binding IsDtcsView}"       Click="OnShowDtcs" />
                    <Button Content="Live Data"  Classes="tab" Classes.active="{Binding IsLiveDataView}"  Click="OnShowLiveData" />
                    <Button Content="CAN Log"    Classes="tab" Classes.active="{Binding IsCanLogView}"     Click="OnShowCanLog" />
                    <Button Content="Updates"    Classes="tab" Classes.active="{Binding IsUpdatesView}"    Click="OnShowUpdates" />
                </StackPanel>

                <!-- Connection state indicator -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsConnected}">
                        <TextBlock Text="●" FontSize="10" Foreground="{StaticResource BrushOk}"      VerticalAlignment="Center" />
                        <TextBlock Text="Connected"   FontSize="11" Foreground="{StaticResource BrushFgSubtle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsConnecting}">
                        <TextBlock Text="●" FontSize="10" Foreground="{StaticResource BrushWarn}"    VerticalAlignment="Center" />
                        <TextBlock Text="Connecting…" FontSize="11" Foreground="{StaticResource BrushFgSubtle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsIdle}">
                        <TextBlock Text="●" FontSize="10" Foreground="{StaticResource BrushFgDim}"   VerticalAlignment="Center" />
                        <TextBlock Text="No vehicle"  FontSize="11" Foreground="{StaticResource BrushFgDim}"    VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <views:ConnectionView IsVisible="{Binding IsConnectionView}" />
            <views:VehicleView    IsVisible="{Binding IsVehicleView}" />
            <views:EmissionsView  IsVisible="{Binding IsEmissionsView}" />
            <views:DtcsView       IsVisible="{Binding IsDtcsView}" />
            <views:CanView        IsVisible="{Binding IsCanLogView}" />
            <views:LiveDataView   IsVisible="{Binding IsLiveDataView}" />
            <views:UpdatesView    IsVisible="{Binding IsUpdatesView}" />
        </Grid>

    </Grid>

</UserControl>
