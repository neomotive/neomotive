<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:views="clr-namespace:Neomotive.ScanTool.UI.Views"
             x:Class="Neomotive.ScanTool.UI.Views.ScanToolView"
             x:DataType="local:MainWindowViewModel"
             ToolTip.ServiceEnabled="{Binding ShowToolTips}">

    <!-- ToolTip.ServiceEnabled inherits down the visual tree, so this one binding is the whole
         "show tooltips" setting: off, and no descendant shows a tip regardless of its own
         ToolTip.Tip. Default is off — see AppSettings.ShowToolTips for why. -->
    <Grid RowDefinitions="42, *">

        <!-- Tab bar -->
        <Border Grid.Row="0"
                Background="#141820"
                BorderBrush="#2E3440"
                BorderThickness="0,0,0,1">
            <Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <!-- Connection is an icon rather than a word: it frees the widest label in the
                         bar, and the icon colour carries the connection state, so the separate
                         "No vehicle" indicator on the right is no longer needed.

                         Saturated red/green rather than the muted theme brushes: this is the one
                         piece of state read from arm's length in a driveway, and the dim grey it
                         used for "not connected" was easy to miss entirely. Amber marks the
                         transient connecting state. -->
                    <!-- No tooltip for the status text: there is no hover on the panel, and the
                         tip only ever restated what the icon colour already says. The full text
                         lives one tap away, on the Connection view this button opens. The binding
                         stays as the accessibility name, which costs no screen space. -->
                    <Button Classes="tab tab-icon" Classes.active="{Binding IsConnectionView}"
                            Click="OnShowConnection" AutomationProperties.Name="{Binding StatusText}"
                            ToolTip.Tip="{Binding StatusText}">
                        <Panel Width="24" Height="24">
                            <Path Data="{StaticResource IconCanConnected}" Stretch="Uniform"
                                  Fill="#22C55E" IsVisible="{Binding IsConnected}" />
                            <Path Data="{StaticResource IconCanConnected}" Stretch="Uniform"
                                  Fill="#F5A524" IsVisible="{Binding IsConnecting}" />
                            <Path Data="{StaticResource IconCanDisconnected}" Stretch="Uniform"
                                  Fill="#EF4444" IsVisible="{Binding IsIdle}" />
                        </Panel>
                    </Button>
                    <Button Content="Vehicle"    Classes="tab" Classes.active="{Binding IsVehicleView}"    Click="OnShowVehicle" />
                    <Button Content="Monitors"  Classes="tab" Classes.active="{Binding IsEmissionsView}"  Click="OnShowEmissions" />
                    <!-- DTCs covers every trouble code in the vehicle now, OBD-II and UDS alike:
                         a tech asks what is wrong, not which protocol answered. Diag is the
                         bus-level tab the protocols retreated to, CAN and UDS as sub-tabs. -->
                    <Button Content="DTCs"       Classes="tab" Classes.active="{Binding IsDtcsView}"       Click="OnShowDtcs" />
                    <Button Content="Live Data"  Classes="tab" Classes.active="{Binding IsLiveDataView}"  Click="OnShowLiveData" />
                    <Button Content="Capture"    Classes="tab" Classes.active="{Binding IsCaptureView}"    Click="OnShowCapture" />
                    <Button Content="Diag"       Classes="tab" Classes.active="{Binding IsDiagView}"       Click="OnShowDiag" />
                    <Button Content="Updates"    Classes="tab" Classes.active="{Binding IsUpdatesView}"    Click="OnShowUpdates" />
                </StackPanel>

                <!-- Right-aligned action buttons: Screen capture and Settings -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Classes="tab tab-icon"
                            Click="OnScreenCapture"
                            AutomationProperties.Name="Screen capture"
                            ToolTip.Tip="Capture screen (save screenshot)">
                        <Panel Width="20" Height="20">
                            <Path Data="{StaticResource IconCamera}" Stretch="Uniform" Fill="#C8D0DA" />
                        </Panel>
                    </Button>

                    <Button Classes="tab tab-icon" Classes.active="{Binding IsSettingsView}"
                            Click="OnShowSettings"
                            AutomationProperties.Name="Settings"
                            ToolTip.Tip="Settings">
                        <Panel Width="20" Height="20">
                            <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Fill="#C8D0DA" />
                        </Panel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <views:ConnectionView IsVisible="{Binding IsConnectionView, FallbackValue=True}" />
            <views:VehicleView    IsVisible="{Binding IsVehicleView, FallbackValue=False}" />
            <views:EmissionsView  IsVisible="{Binding IsEmissionsView, FallbackValue=False}" />
            <views:DtcsView       IsVisible="{Binding IsDtcsView, FallbackValue=False}" />
            <views:DiagView       IsVisible="{Binding IsDiagView, FallbackValue=False}" />
            <views:LiveDataView   IsVisible="{Binding IsLiveDataView, FallbackValue=False}" />
            <!-- Wrapped: CaptureView swaps its own DataContext, so visibility has to be bound on
                 a container that still sees MainWindowViewModel. -->
            <Panel IsVisible="{Binding IsCaptureView, FallbackValue=False}">
                <views:CaptureView DataContext="{Binding CaptureVm}" />
            </Panel>
            <views:UpdatesView    IsVisible="{Binding IsUpdatesView, FallbackValue=False}" />
            <Panel IsVisible="{Binding IsSettingsView, FallbackValue=False}">
                <views:SettingsView DataContext="{Binding SettingsVm}" />
            </Panel>
        </Grid>

        <!-- Toast notification. Shown briefly after screen capture or scan capture. -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Background="#E61A2030"
                BorderBrush="#4CAF50"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,8"
                IsVisible="{Binding ShowToast}"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="value" Text="✓" Foreground="#4CAF50" FontWeight="Bold" />
                <TextBlock Classes="value" Text="{Binding ToastMessage}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Connection-failure help. Hosted at the shell so it covers the tab bar too: a failed
             connect is not a per-tab condition, and the diagram wants the whole panel. -->
        <Panel Grid.Row="0" Grid.RowSpan="2"
               IsVisible="{Binding ShowNoVehicleHelp}" Background="#CC0B0E13">
            <views:NoVehicleDialog />
        </Panel>

    </Grid>

</UserControl>
