<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:views="clr-namespace:Neomotive.ScanTool.UI.Views"
             xmlns:canviews="clr-namespace:Neomotive.Can.UI.Views;assembly=Neomotive.Can.UI"
             x:Class="Neomotive.ScanTool.UI.Views.ScanToolView"
             x:DataType="local:MainWindowViewModel">

    <Grid RowDefinitions="42, *">

        <!-- Tab bar -->
        <Border Grid.Row="0"
                Background="#141820"
                BorderBrush="#2E3440"
                BorderThickness="0,0,0,1">
            <Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <!-- Connection is an icon rather than a word: it frees the widest label in the
                         bar, and the icon colour carries the connection state, so the separate
                         "No vehicle" indicator on the right is no longer needed.

                         Saturated red/green rather than the muted theme brushes: this is the one
                         piece of state read from arm's length in a driveway, and the dim grey it
                         used for "not connected" was easy to miss entirely. Amber marks the
                         transient connecting state. -->
                    <Button Classes="tab tab-icon" Classes.active="{Binding IsConnectionView}"
                            Click="OnShowConnection" ToolTip.Tip="{Binding StatusText}">
                        <Panel Width="24" Height="24">
                            <Path Data="{StaticResource IconCanConnected}" Stretch="Uniform"
                                  Fill="#22C55E" IsVisible="{Binding IsConnected}" />
                            <Path Data="{StaticResource IconCanConnected}" Stretch="Uniform"
                                  Fill="#F5A524" IsVisible="{Binding IsConnecting}" />
                            <Path Data="{StaticResource IconCanDisconnected}" Stretch="Uniform"
                                  Fill="#EF4444" IsVisible="{Binding IsIdle}" />
                        </Panel>
                    </Button>
                    <Button Content="Vehicle"    Classes="tab" Classes.active="{Binding IsVehicleView}"    Click="OnShowVehicle" />
                    <Button Content="Monitors"  Classes="tab" Classes.active="{Binding IsEmissionsView}"  Click="OnShowEmissions" />
                    <Button Content="DTCs"       Classes="tab" Classes.active="{Binding IsDtcsView}"       Click="OnShowDtcs" />
                    <Button Content="UDS"        Classes="tab" Classes.active="{Binding IsUdsView}"        Click="OnShowUds" />
                    <Button Content="Live Data"  Classes="tab" Classes.active="{Binding IsLiveDataView}"  Click="OnShowLiveData" />
                    <Button Content="Capture"    Classes="tab" Classes.active="{Binding IsCaptureView}"    Click="OnShowCapture" />
                    <Button Content="CAN"        Classes="tab" Classes.active="{Binding IsCanLogView}"     Click="OnShowCanLog" />
                    <Button Content="Updates"    Classes="tab" Classes.active="{Binding IsUpdatesView}"    Click="OnShowUpdates" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <views:ConnectionView IsVisible="{Binding IsConnectionView}" />
            <views:VehicleView    IsVisible="{Binding IsVehicleView}" />
            <views:EmissionsView  IsVisible="{Binding IsEmissionsView}" />
            <views:DtcsView       IsVisible="{Binding IsDtcsView}" />
            <views:UdsView        IsVisible="{Binding IsUdsView}" />
            <canviews:CanView     IsVisible="{Binding IsCanLogView}" />
            <views:LiveDataView   IsVisible="{Binding IsLiveDataView}" />
            <!-- Wrapped: CaptureView swaps its own DataContext, so visibility has to be bound on
                 a container that still sees MainWindowViewModel. -->
            <Panel IsVisible="{Binding IsCaptureView}">
                <views:CaptureView DataContext="{Binding CaptureVm}" />
            </Panel>
            <views:UpdatesView    IsVisible="{Binding IsUpdatesView}" />
        </Grid>

    </Grid>

</UserControl>
