<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             x:Class="Neomotive.ScanTool.UI.Views.LiveDataTablePane"
             x:DataType="local:MainWindowViewModel"
             Padding="0">

    <Grid RowDefinitions="Auto, *">

        <!-- Column headers -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="16,6,8,6">
            <Grid ColumnDefinitions="*, 90, 60">
                <TextBlock Grid.Column="0" Classes="label" Text="PID"/>
                <TextBlock Grid.Column="1" Classes="label" Text="Value"/>
                <TextBlock Grid.Column="2" Classes="label" Text="Unit"/>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Classes="dim"
                   IsVisible="{Binding HasNoSelectedPids}"
                   Text="Select PIDs from the left panel"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Data rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasSelectedPids}">
            <ItemsControl ItemsSource="{Binding SelectedLivePids}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LivePidItem">
                        <Border Padding="16,0,8,0" MinHeight="44">
                            <Grid ColumnDefinitions="*, 90, 60" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Classes="label"
                                           Text="{Binding Descriptor.Name}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="value"
                                           Text="{Binding ValueText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="dim"
                                           Text="{Binding Descriptor.Unit}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
