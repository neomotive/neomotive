<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:views="clr-namespace:Neomotive.ScanTool.UI.Views"
             x:Class="Neomotive.ScanTool.UI.Views.LiveDataView"
             x:DataType="local:MainWindowViewModel">

    <Grid>
      <Grid ColumnDefinitions="220, *">

        <!-- Left: the chosen signals. Adding is done in the search modal rather than by
             scrolling a list of every PID the vehicle supports. -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto">

            <TextBlock Grid.Row="0" Classes="dim xs" Margin="10"
                       TextWrapping="Wrap" IsVisible="{Binding HasNoSelectedPids}"
                       Text="No signals selected. Press Add to search the PID table." />

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasSelectedPids}">
                <ItemsControl ItemsSource="{Binding LivePidItems}" Padding="0,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LivePidItem">
                            <Grid ColumnDefinitions="*, Auto" Margin="8,2">
                                <TextBlock Grid.Column="0" Text="{Binding Descriptor.Name}"
                                           Classes="pid-name" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource BrushFgDefault}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Descriptor.Unit}"
                                           Classes="xs dim" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="8,4,8,6">
                <Button Content="Add…"  Classes="action-sm" Click="OnOpenPicker"/>
                <Button Content="Clear" Classes="action-sm" Click="OnSelectNone"/>
            </StackPanel>
        </Grid>

        <!-- Vertical divider -->
        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                   Fill="{StaticResource BrushBorder}" IsHitTestVisible="False"/>

        <!-- Right: sub-tab bar + panes -->
        <Grid Grid.Column="1" RowDefinitions="36, *">

            <!-- Sub-tab bar -->
            <Border Grid.Row="0" Background="#141820"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Table"    Classes="tab" Classes.active="{Binding IsTableView}"    Click="OnShowTable"/>
                        <Button Content="Gauges"   Classes="tab" Classes.active="{Binding IsGaugesView}"   Click="OnShowGauges"/>
                        <Button Content="Waveform" Classes="tab" Classes.active="{Binding IsWaveformView}" Click="OnShowWaveform"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- The achieved rate, on screen rather than inferred from how the needles
                             feel. A slow sweep is a fact to read, not an impression. -->
                        <TextBlock Classes="xs dim" VerticalAlignment="Center"
                                   IsVisible="{Binding HasPollRate}"
                                   Text="{Binding PollRateText}"/>
                        <Button Content="Retry no-response" Classes="action-sm"
                                IsVisible="{Binding HasUnansweredPids}"
                                Click="OnRetryUnanswered"/>
                        <Button Content="▶ Start" Classes="action-sm"
                                IsVisible="{Binding !IsPolling}"
                                IsEnabled="{Binding CanStartPolling}"
                                Click="OnStartPolling"/>
                        <Button Content="■ Stop" Classes="action-sm"
                                IsVisible="{Binding IsPolling}"
                                Click="OnStopPolling"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content panes -->
            <Grid Grid.Row="1">
                <views:LiveDataTablePane    IsVisible="{Binding IsTableView}"/>
                <views:LiveDataGaugePane    IsVisible="{Binding IsGaugesView}"/>
                <views:LiveDataWaveformPane IsVisible="{Binding IsWaveformView}" Name="WaveformPane"/>
            </Grid>

        </Grid>
      </Grid>

        <!-- Same picker as capture, hosted as an overlay: the Pi has no window manager. -->
        <Panel IsVisible="{Binding LivePicker.IsOpen}" Background="#CC0B0E13">
            <views:SignalPickerView DataContext="{Binding LivePicker}" />
        </Panel>
    </Grid>
</UserControl>
