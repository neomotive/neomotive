<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             x:Class="Neomotive.ScanTool.UI.Views.LiveDataWaveformPane"
             x:DataType="local:MainWindowViewModel">

    <Grid>
    <!-- Empty state -->
    <TextBlock Classes="dim"
               IsVisible="{Binding HasNoSelectedPids}"
               Text="Select PIDs from the left panel to graph"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <!-- 4 stacked waveform slots -->
    <StackPanel IsVisible="{Binding HasSelectedPids}" Spacing="0">

        <Border Name="Slot0" Height="95" Background="#0E1117"
                BorderBrush="#1E2530" BorderThickness="0,0,0,1" Margin="0">
            <Grid>
                <Canvas Name="Slot0Canvas" ClipToBounds="True">
                    <Polyline Name="Slot0Primary"   Stroke="#4CAF50" StrokeThickness="1.5"/>
                    <Polyline Name="Slot0Secondary" Stroke="#2196F3" StrokeThickness="1.5"/>
                </Canvas>
                <TextBlock Name="Slot0LeftLabel"  Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="4,2,0,0"/>
                <TextBlock Name="Slot0RightLabel" Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
            </Grid>
        </Border>

        <Border Name="Slot1" Height="95" Background="#0E1117"
                BorderBrush="#1E2530" BorderThickness="0,0,0,1">
            <Grid>
                <Canvas Name="Slot1Canvas" ClipToBounds="True">
                    <Polyline Name="Slot1Primary"   Stroke="#FF9800" StrokeThickness="1.5"/>
                    <Polyline Name="Slot1Secondary" Stroke="#9C27B0" StrokeThickness="1.5"/>
                </Canvas>
                <TextBlock Name="Slot1LeftLabel"  Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="4,2,0,0"/>
                <TextBlock Name="Slot1RightLabel" Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
            </Grid>
        </Border>

        <Border Name="Slot2" Height="95" Background="#0E1117"
                BorderBrush="#1E2530" BorderThickness="0,0,0,1">
            <Grid>
                <Canvas Name="Slot2Canvas" ClipToBounds="True">
                    <Polyline Name="Slot2Primary"   Stroke="#E91E63" StrokeThickness="1.5"/>
                    <Polyline Name="Slot2Secondary" Stroke="#00BCD4" StrokeThickness="1.5"/>
                </Canvas>
                <TextBlock Name="Slot2LeftLabel"  Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="4,2,0,0"/>
                <TextBlock Name="Slot2RightLabel" Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
            </Grid>
        </Border>

        <Border Name="Slot3" Height="95" Background="#0E1117">
            <Grid>
                <Canvas Name="Slot3Canvas" ClipToBounds="True">
                    <Polyline Name="Slot3Primary"   Stroke="#CDDC39" StrokeThickness="1.5"/>
                    <Polyline Name="Slot3Secondary" Stroke="#FF5722" StrokeThickness="1.5"/>
                </Canvas>
                <TextBlock Name="Slot3LeftLabel"  Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="4,2,0,0"/>
                <TextBlock Name="Slot3RightLabel" Classes="xs dim" TextWrapping="NoWrap"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
            </Grid>
        </Border>

    </StackPanel>
    </Grid>
</UserControl>
