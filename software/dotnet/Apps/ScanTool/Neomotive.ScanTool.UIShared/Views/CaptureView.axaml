<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Neomotive.ScanTool.UI"
             xmlns:views="clr-namespace:Neomotive.ScanTool.UI.Views"
             x:Class="Neomotive.ScanTool.UI.Views.CaptureView"
             x:DataType="local:CaptureViewModel">

    <Grid>
        <!-- Main content -->
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

            <!-- Setup: profile, signals, trigger. The scrolling sidebar is gone; each of these
                 opens a modal, which leaves the full width for the trace. -->
            <Border Grid.Row="0" Background="#141820" Padding="8,6"
                    BorderBrush="#1E2530" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto, 150, 190, Auto, Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="label" Text="Profile"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" />
                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ProfilesInCategory}"
                              SelectedItem="{Binding SelectedProfile}" />
                    <Button Grid.Column="3" Content="Apply" Click="OnApplyProfile"
                            IsEnabled="{Binding HasSelectedProfile}" />
                    <Button Grid.Column="4" Content="Signals…" Click="OnOpenPicker" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="8,4">
                <StackPanel Spacing="2">
                    <TextBlock Classes="xs dim" TextWrapping="Wrap"
                               IsVisible="{Binding HasSelectedProfile}"
                               Text="{Binding SelectedProfileDescription}" />
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Classes="xs" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedSummary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Trigger…" Click="OnOpenTrigger" />
                    </Grid>
                    <TextBlock Classes="xs dim" TextWrapping="Wrap"
                               Text="{Binding TriggerSummary, StringFormat='Trigger: {0}'}" />
                </StackPanel>
            </Border>

            <!-- Run controls -->
            <Border Grid.Row="2" Background="#141820" Padding="8,6"
                    BorderBrush="#1E2530" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Arm"     Click="OnArm"     IsEnabled="{Binding CanArm}" />
                    <Button Content="Trigger" Click="OnTrigger" IsEnabled="{Binding IsWaitingForTrigger}" />
                    <Button Content="Stop"    Click="OnStop"    IsEnabled="{Binding IsArmed}" />
                    <TextBlock Classes="xs dim" VerticalAlignment="Center" Text="{Binding RateText}" />
                    <TextBlock Classes="xs dim" VerticalAlignment="Center"
                               Text="{Binding SampleCount, StringFormat='{}{0} samples'}" />
                    <TextBlock Classes="xs" VerticalAlignment="Center" Text="{Binding Status}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <views:CaptureReviewPane Grid.Row="3" DataContext="{Binding}" />

            <Border Grid.Row="4" Background="#141820" Padding="8,6"
                    BorderBrush="#1E2530" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <TextBlock Grid.Column="0" Classes="xs dim" VerticalAlignment="Center"
                               Margin="0,0,6,0" Text="Saved" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Recordings}"
                              SelectedItem="{Binding SelectedRecording}" />
                    <Button Grid.Column="2" Content="Refresh" Margin="6,0,0,0" Click="OnRefresh" />
                    <Button Grid.Column="3" Content="Export wide CSV" Margin="6,0,0,0"
                            Click="OnExport" IsEnabled="{Binding HasLoadedRecording}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Modal overlays. Hosted here rather than as Windows because the Pi runs a single-view
             DRM lifetime with no window manager, so a real dialog would have nowhere to go. -->
        <Panel IsVisible="{Binding Picker.IsOpen}" Background="#CC0B0E13">
            <views:SignalPickerView DataContext="{Binding Picker}" />
        </Panel>

        <Panel IsVisible="{Binding TriggerEditor.IsOpen}" Background="#CC0B0E13">
            <views:TriggerEditorView DataContext="{Binding TriggerEditor}" />
        </Panel>
    </Grid>
</UserControl>
