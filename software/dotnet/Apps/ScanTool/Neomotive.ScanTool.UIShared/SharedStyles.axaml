<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StyleInclude Source="avares://Neomotive.UI.Styles/Styles.axaml" />

    <!-- ScanTool-specific additions -->

    <Style Selector="TextBlock.vin">
        <Setter Property="FontSize"   Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrushFgValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-ok">
        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-warn">
        <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-na">
        <Setter Property="Foreground" Value="{StaticResource BrushFgDim}" />
        <Setter Property="FontStyle"  Value="Italic" />
    </Style>

    <!-- PID list row button (touch-primary, full-width, 44px min-height) -->
    <Style Selector="Button.live-pid-row">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="Padding"          Value="8,3,8,3" />
        <Setter Property="MinHeight"        Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius"     Value="0" />
        <Setter Property="Cursor"           Value="Hand" />
    </Style>
    <Style Selector="Button.live-pid-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A2030" />
    </Style>
    <Style Selector="Button.live-pid-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#243040" />
    </Style>
    <Style Selector="Button.live-pid-row.selected">
        <Setter Property="BorderBrush"    Value="#4CAF50" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.live-pid-row.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#0D2218" />
    </Style>
    <Style Selector="Button.live-pid-row.selected TextBlock.pid-indicator">
        <Setter Property="Foreground" Value="#4CAF50" />
    </Style>
    <Style Selector="Button.live-pid-row.selected TextBlock.pid-name">
        <Setter Property="Foreground" Value="#A5D6A7" />
    </Style>

</Styles>
