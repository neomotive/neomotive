<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StyleInclude Source="avares://Neomotive.UI.Styles/Styles.axaml" />

    <Styles.Resources>
        <!-- CAN network connection glyphs. Drawn paths rather than font glyphs so they render
             reliably under minimal font environments (e.g. Raspberry Pi DRM/KMS). -->
        <StreamGeometry x:Key="IconCanConnected">M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83L6.34,12C4.78,10.44 4.78,7.9 6.34,6.34C7.9,4.78 10.44,4.78 12,6.34L14.83,9.17C15.22,9.56 15.22,10.2 14.83,10.59C14.44,11 13.8,11 13.41,10.59L10.59,7.76C9.81,6.97 8.54,6.97 7.76,7.76C6.97,8.54 6.97,9.81 7.76,10.59L10.59,13.41M13.41,10.59C13,10.2 13,9.56 13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17L17.66,12C19.22,13.56 19.22,16.1 17.66,17.66C16.1,19.22 13.56,19.22 12,17.66L9.17,14.83C8.78,14.44 8.78,13.8 9.17,13.41C9.56,13.03 10.2,13.03 10.59,13.41L13.41,16.24C14.2,17.03 15.46,17.03 16.24,16.24C17.03,15.46 17.03,14.2 16.24,13.41L13.41,10.59Z</StreamGeometry>
        <StreamGeometry x:Key="IconCanDisconnected">M22.11,21.46L2.39,1.73L1.11,3L5.83,7.71C4.69,8.92 4,10.37 4,12C4,15.31 6.69,18 10,18H14C14.8,18 15.56,17.79 16.23,17.43L20.84,22.04L22.11,21.46M10,16C7.79,16 6,14.21 6,12C6,11 6.36,10.09 7,9.41L13.59,16H10M20,12C20,8.69 17.31 6 14,6H10C9.17,6 8.39,6.22 7.71,6.6L9.24,8.13C9.47,8.05 9.73,8 10,8H14C16.21,8 18,9.79 18,12C18,12.27 17.95,12.53 17.87,12.76L19.4,14.29C19.78,13.61 20,12.83 20,12Z</StreamGeometry>
        <!-- Gear. Same drawn-path reasoning as the CAN glyphs above: no font dependency. -->
        <StreamGeometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
    </Styles.Resources>

    <!-- ScanTool-specific additions -->

    <!--
        TextBox theming. Fluent's dark TextBox turns near-white when focused, which is correct for
        a light-on-dark document but wrong here: it flares against the panel and reads as a
        misplaced control rather than a focused field. Nothing styled TextBox before, so this was
        visible on every text field in the app, not just the DID entry.

        Overriding the theme resources rather than writing :focus setters keeps the fix in one
        place and stays with the Fluent template's own state handling.
    -->
    <Style Selector="TextBox">
        <Style.Resources>
            <SolidColorBrush x:Key="TextControlBackground"                Color="#0E1117" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"     Color="#141A24" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused"         Color="#0E1117" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled"        Color="#12151B" />

            <SolidColorBrush x:Key="TextControlForeground"                Color="#C8CDD6" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"     Color="#E0E5EC" />
            <SolidColorBrush x:Key="TextControlForegroundFocused"         Color="#E0E5EC" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled"        Color="#556878" />

            <SolidColorBrush x:Key="TextControlBorderBrush"               Color="#2E3440" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"    Color="#3C4557" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"        Color="#4A7C59" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled"       Color="#232833" />

            <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#6A7888" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6A7888" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#556878" />

            <SolidColorBrush x:Key="TextControlSelectionHighlightColor"   Color="#2F5D8C" />
        </Style.Resources>

        <Setter Property="MinHeight"       Value="30" />
        <Setter Property="Padding"         Value="7,4" />
        <Setter Property="CornerRadius"    Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
        <Setter Property="FontSize"        Value="13" />
    </Style>

    <!-- Icon-only tab. Narrower than a labelled tab but still a comfortable touch target on the
         800x480 panel, so dropping the word does not make the button harder to hit. -->
    <Style Selector="Button.tab-icon">
        <Setter Property="Padding"  Value="14,6" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.vin">
        <Setter Property="FontSize"   Value="20" />
        <Setter Property="Foreground" Value="{StaticResource BrushFgValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-ok">
        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-warn">
        <Setter Property="Foreground" Value="{StaticResource BrushWarn}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.status-na">
        <Setter Property="Foreground" Value="{StaticResource BrushFgDim}" />
        <Setter Property="FontStyle"  Value="Italic" />
    </Style>

    <!-- PID list row button (touch-primary, full-width, 44px min-height) -->
    <Style Selector="Button.live-pid-row">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="Padding"          Value="8,3,8,3" />
        <Setter Property="MinHeight"        Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius"     Value="0" />
        <Setter Property="Cursor"           Value="Hand" />
    </Style>
    <Style Selector="Button.live-pid-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A2030" />
    </Style>
    <Style Selector="Button.live-pid-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#243040" />
    </Style>
    <Style Selector="Button.live-pid-row.selected">
        <Setter Property="BorderBrush"    Value="#4CAF50" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.live-pid-row.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#0D2218" />
    </Style>
    <Style Selector="Button.live-pid-row.selected TextBlock.pid-indicator">
        <Setter Property="Foreground" Value="#4CAF50" />
    </Style>
    <Style Selector="Button.live-pid-row.selected TextBlock.pid-name">
        <Setter Property="Foreground" Value="#A5D6A7" />
    </Style>

    <!-- Signal picker result row. Tighter than live-pid-row so the modal shows more of a
         ~110-entry table at 800x480, while staying a comfortable touch target. -->
    <Style Selector="Button.pidrow">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="8,4" />
        <Setter Property="MinHeight"       Value="30" />
        <Setter Property="FontSize"        Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius"    Value="0" />
        <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.pidrow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A2030" />
    </Style>
    <Style Selector="Button.pidrow:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#243040" />
    </Style>

    <!-- System filter chip. The default Fluent button padding made these wide enough to
         overflow the row; these are sized to fit several per line at 800px. -->
    <Style Selector="Button.chip">
        <Setter Property="Background"      Value="#1A2030" />
        <Setter Property="BorderBrush"     Value="#2E3440" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"         Value="7,3" />
        <Setter Property="MinHeight"       Value="26" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="FontSize"        Value="11" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#243040" />
    </Style>

    <!-- Numeric keypad key. Stretches to fill its grid cell: the default Fluent button centres
         itself at its content size, which left the keys as small squares floating in dead space. -->
    <Style Selector="Button.keypad">
        <Setter Property="HorizontalAlignment"        Value="Stretch" />
        <Setter Property="VerticalAlignment"          Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="MinHeight"       Value="40" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="FontSize"        Value="19" />
        <Setter Property="Background"      Value="#1A2030" />
        <Setter Property="BorderBrush"     Value="#2E3440" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="4" />
        <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Button.keypad:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#243040" />
    </Style>
    <Style Selector="Button.keypad:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#31415A" />
    </Style>

</Styles>
