<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <AssemblyName>scantool</AssemblyName>
    <Version>1.0.0</Version>

    <!-- Release version, set by create-update-package.ps1.
         Deliberately NOT plain -p:Version on the publish command line: a
         command-line property is a GLOBAL property, so it flows into every
         ProjectReference too - including the Meadow libraries this repo builds
         from source (Contracts, Logging, Units, Telematics.*). Those got stamped
         with the app's version while the NuGet Meadow packages still bound to
         Meadow.Contracts 3.0.1.0, and the device crash-looped on startup with
         "Could not load file or assembly 'Meadow.Contracts, Version=3.0.1.0'".
         A uniquely named property propagates just as widely but only this
         project reads it, so the Meadow projects keep their own versions. -->
    <Version Condition="'$(NeomotivePackageVersion)' != ''">$(NeomotivePackageVersion)</Version>
    <AssemblyVersion Condition="'$(NeomotivePackageVersion)' != ''">$(NeomotivePackageVersion)</AssemblyVersion>
    <FileVersion Condition="'$(NeomotivePackageVersion)' != ''">$(NeomotivePackageVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meadow.Avalonia" Version="3.*-*" />
    <PackageReference Include="Meadow.Linux" Version="3.*-*" />
    <PackageReference Include="Meadow.Foundation.ICs.CAN.Mcp2515" Version="3.*-*" />
    <PackageReference Include="Meadow.Logging.LogProviders" Version="3.*-*" />
    <ProjectReference Include="..\..\Shared\Neomotive.Can.Hardware\Neomotive.Can.Hardware.csproj" />
    <ProjectReference Include="..\Neomotive.ScanTool.UIShared\Neomotive.ScanTool.UIShared.csproj" />
  </ItemGroup>
</Project>
