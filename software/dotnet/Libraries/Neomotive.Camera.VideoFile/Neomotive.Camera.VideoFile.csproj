<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <!-- Windows runtime included -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- Linux: Use system-installed OpenCV (install via: apt-get install libopencv-dev) -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neomotive.Core\Neomotive.Core.csproj" />
  </ItemGroup>

</Project>
