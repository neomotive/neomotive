<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Neomotive.ModuleSimulator.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- ── Typography ──────────────────────────────────────────────────── -->

        <!-- All TextBlocks default to monospace -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Consolas,Cascadia Code,monospace" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="#C8CDD6" />
        </Style>

        <!-- Colour roles -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#4A5568" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#344050" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="#2A3540" />
            <Setter Property="FontStyle"  Value="Italic" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#88C0D0" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="#6DBF67" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#D4A050" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#E06060" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.tx">
            <Setter Property="Foreground" Value="#5E9FE0" />
        </Style>
        <Style Selector="TextBlock.rx">
            <Setter Property="Foreground" Value="#C8A040" />
        </Style>
        <Style Selector="TextBlock.mil-on">
            <Setter Property="Foreground" Value="#E06060" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.mil-off">
            <Setter Property="Foreground" Value="#6DBF67" />
        </Style>
        <Style Selector="TextBlock.pcm-name">
            <Setter Property="Foreground"  Value="#6DBF67" />
            <Setter Property="FontWeight"  Value="SemiBold" />
            <Setter Property="FontSize"    Value="12" />
        </Style>
        <Style Selector="TextBlock.tcu-name">
            <Setter Property="Foreground"  Value="#6BB8D4" />
            <Setter Property="FontWeight"  Value="SemiBold" />
            <Setter Property="FontSize"    Value="12" />
        </Style>

        <!-- Size modifiers -->
        <Style Selector="TextBlock.sm">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="TextBlock.xs">
            <Setter Property="FontSize" Value="9" />
        </Style>

        <!-- Section headings: uppercase, letter-spaced, tiny -->
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize"      Value="9" />
            <Setter Property="FontWeight"    Value="Bold" />
            <Setter Property="Foreground"    Value="#384050" />
            <Setter Property="LetterSpacing" Value="2" />
        </Style>

        <!-- ── Module panel ────────────────────────────────────────────────── -->

        <Style Selector="Border.module">
            <Setter Property="Background"      Value="#1C2028" />
            <Setter Property="BorderBrush"     Value="#2E3440" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="3" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="Margin"          Value="0,0,0,5" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Border.module.selected">
            <Setter Property="Background"  Value="#1A2A1A" />
            <Setter Property="BorderBrush" Value="#4A7C4A" />
        </Style>

        <!-- ── Tab buttons ─────────────────────────────────────────────────── -->

        <Style Selector="Button.tab">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="#556070" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="Padding"         Value="12,4" />
            <Setter Property="CornerRadius"    Value="0" />
            <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
            <Setter Property="FontSize"        Value="11" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C0C8D4" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground"  Value="#E0E5EC" />
            <Setter Property="BorderBrush" Value="#4A7C59" />
            <Setter Property="FontWeight"  Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E0E5EC" />
        </Style>

        <!-- ── DTC toggle buttons ──────────────────────────────────────────── -->

        <Style Selector="Button.dtc">
            <Setter Property="Background"      Value="#1A1E26" />
            <Setter Property="BorderBrush"     Value="#2E3440" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="3" />
            <Setter Property="Padding"         Value="7,3" />
            <Setter Property="Margin"          Value="0,0,4,0" />
            <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Foreground"      Value="#556070" />
        </Style>
        <Style Selector="Button.dtc:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#222830" />
        </Style>
        <Style Selector="Button.dtc.active">
            <Setter Property="Background"  Value="#3A1A1A" />
            <Setter Property="BorderBrush" Value="#8A3030" />
            <Setter Property="Foreground"  Value="#E06060" />
        </Style>
        <Style Selector="Button.dtc.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A2020" />
        </Style>

        <!-- ── Monitor row toggle ──────────────────────────────────────────── -->

        <Style Selector="Button.monitor-row">
            <Setter Property="Background"               Value="Transparent" />
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Padding"                  Value="0" />
            <Setter Property="HorizontalAlignment"      Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin"                   Value="0,0,0,2" />
            <Setter Property="Cursor"                   Value="Hand" />
        </Style>
        <Style Selector="Button.monitor-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2030" />
        </Style>
        <Style Selector="Button.monitor-row:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor"     Value="Arrow" />
        </Style>

        <!-- ── Small action buttons ────────────────────────────────────────── -->

        <Style Selector="Button.action-sm">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderBrush"     Value="#3A4050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="3" />
            <Setter Property="Padding"         Value="5,1" />
            <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
            <Setter Property="FontSize"        Value="10" />
            <Setter Property="Foreground"      Value="#556070" />
        </Style>
        <Style Selector="Button.action-sm:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A1A1A" />
            <Setter Property="Foreground" Value="#E06060" />
        </Style>

        <!-- ── Category cycle button ────────────────────────────────────────── -->

        <Style Selector="Button.category">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Foreground"      Value="#4A5568" />
            <Setter Property="FontFamily"      Value="Consolas,Cascadia Code,monospace" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.category:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#88C0D0" />
        </Style>

    </Application.Styles>
</Application>
